{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weekly discovery LLM output — proposals only, never trusted",
  "type": "object",
  "required": ["relocated_urls", "proposed_sources", "one_off_events", "digest_notes"],
  "additionalProperties": false,
  "properties": {
    "relocated_urls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "new_url"],
        "properties": {
          "source_id": { "type": "string" },
          "new_url": { "type": "string", "pattern": "^https?://" },
          "evidence": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "proposed_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kid", "category", "url", "scan_method"],
        "properties": {
          "id": { "type": "string", "pattern": "^prop-[a-z0-9-]{2,76}$" },
          "name": { "type": "string", "minLength": 3, "maxLength": 120 },
          "kid": { "enum": ["ridhi", "dhruv", "both"] },
          "category": { "enum": ["volunteer", "club", "event", "program", "athletics", "library", "school-page"] },
          "url": { "type": "string", "pattern": "^https?://" },
          "scan_method": { "enum": ["http_diff", "json_api", "manual"] },
          "why": { "type": "string", "maxLength": 300 },
          "eligibility_note": { "type": "string", "maxLength": 300 },
          "confidence": { "enum": ["verified", "estimated"] }
        }
      }
    },
    "one_off_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kid", "title", "date", "org"],
        "properties": {
          "kid": { "enum": ["ridhi", "dhruv", "both", "family"] },
          "title": { "type": "string", "minLength": 3, "maxLength": 200 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "org": { "type": "string", "maxLength": 120 },
          "url": { "type": ["string", "null"], "pattern": "^https?://" },
          "location": { "type": "string", "maxLength": 200 },
          "why": { "type": "string", "maxLength": 300 },
          "confidence": { "enum": ["verified", "estimated"] }
        }
      }
    },
    "digest_notes": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 300 }
    }
  }
}
